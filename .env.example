# ===== 应用 =====
APP_NAME=FastAPI Starter
DEBUG=true

# ===== 数据库 =====
# 本地零配置：SQLite 文件库；上线换成 PostgreSQL（Docker Compose 已配好）
DATABASE_URL=sqlite+aiosqlite:///./app.db
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/app

# 开发期自动建表（生产必须关掉，用 alembic upgrade head）
AUTO_CREATE_TABLES=true

# ===== 安全 =====
# 生产环境务必换掉：python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-only-insecure-secret-key-please-change
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ===== CORS =====
# 前端开发服务器地址，多个用 JSON 数组
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
